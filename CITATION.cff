cff-version: 1.2.0
message: "If you use DenialDojo, please cite the thesis below."
type: software
title: "DenialDojo"
abstract: >-
  A counterfactual benchmark, built on AgentDojo, that measures whether a
  tool-calling LLM agent leaks the reason for an access denial
  (NOT_FOUND vs PERMISSION_DENIED) to an external sink.
authors:
  - family-names: Khandelwal
    given-names: Keshav
version: 0.1.0
license: MIT
keywords:
  - llm-agents
  - prompt-injection
  - agent-security
  - side-channels
  - benchmark
  - agentdojo
preferred-citation:
  type: thesis
  title: "DenialDojo: A Counterfactual Benchmark for Denial-Reason Leakage in Tool-Using Language Model Agents"
  authors:
    - family-names: Khandelwal
      given-names: Keshav
  thesis-type: "Honors thesis"
  institution:
    name: "The Pennsylvania State University, Schreyer Honors College"
  department: "Department of Computer Science and Engineering"
